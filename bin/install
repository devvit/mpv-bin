#!/usr/bin/env bash
set -euo pipefail

# 1. 检查操作系统类型
if [ "$(uname -s)" != "Darwin" ]; then
  echo "Error: This plugin only supports macOS (Darwin)." >&2
  exit 1
fi

# 2. 获取 asdf 传入的参数
INSTALL_TYPE="${1:-}"
VERSION="${2:-}"
INSTALL_PATH="${3:-}"

if [ -z "$INSTALL_PATH" ]; then
  echo "Error: Missing install path argument." >&2
  exit 1
fi

# 3. 判断系统架构
ARCH="$(uname -m)"
case "$ARCH" in
  arm64|aarch64)
    ARCH_KEY="arm64"
    ;;
  x86_64)
    ARCH_KEY="x86_64"
    ;;
  *)
    echo "Error: Unsupported architecture $ARCH" >&2
    exit 1
    ;;
esac

echo "--> Detected Architecture: ${ARCH_KEY}"

# 4. 创建临时下载目录与目标目录
TMP_DIR="$(mktemp -d)"
trap 'rm -rf "$TMP_DIR"' EXIT

BIN_DIR="${INSTALL_PATH}/bin"
LIB_DIR="${INSTALL_PATH}/lib"
mkdir -p "$BIN_DIR" "$LIB_DIR"

# 5. 调用 GitHub API 获取最新的 Release 信息
REPO="eko5624/mpv-mac"
API_URL="https://api.github.com/repos/${REPO}/releases/latest"

echo "--> Fetching latest release info from ${REPO}..."
RELEASE_JSON="$(curl -sSL "$API_URL")"

# 提取符合当前架构的所有 .zip 下载链接
URLS="$(echo "$RELEASE_JSON" | grep -oE 'https://github\.com/[^"]+\.zip' | grep "${ARCH_KEY}" | sort -u)"

if [ -z "$URLS" ]; then
  echo "Error: No matching ZIP assets found for architecture ${ARCH_KEY}." >&2
  exit 1
fi

# 6. 下载并解压 ZIP 文件
echo "$URLS" | while read -r url; do
  [ -z "$url" ] && continue
  filename="$(basename "$url")"
  echo "--> Downloading ${filename}..."
  curl -sSL "$url" -o "${TMP_DIR}/${filename}"
  
  echo "--> Extracting ${filename}..."
  unzip -q -o "${TMP_DIR}/${filename}" -d "$TMP_DIR"
done

# 7. 查找并移动二进制文件到 bin 目录
echo "--> Moving binaries to ${BIN_DIR}..."
TARGET_BINS=("ffmpeg" "ffplay" "ffprobe" "mpv")

for bin in "${TARGET_BINS[@]}"; do
  # 排除刚才下载的 zip 文件本身，查找同名可执行文件
  found_file="$(find "$TMP_DIR" -type f -name "$bin" ! -name "*.zip" | head -n 1)"
  if [ -n "$found_file" ]; then
    cp "$found_file" "${BIN_DIR}/"
    chmod +x "${BIN_DIR}/${bin}"
    echo "    Installed ${bin}"
  else
    echo "    Warning: Binary ${bin} not found in release assets."
  fi
done

# 8. 查找并移动所有 .dylib 动态库到 lib 目录
echo "--> Moving shared libraries (*.dylib) to ${LIB_DIR}..."
find "$TMP_DIR" -type f -name "*.dylib" | while read -r dylib; do
  cp "$dylib" "${LIB_DIR}/"
  echo "    Installed $(basename "$dylib")"
done

echo "--> Installation completed successfully!"
