#!/usr/bin/env bash

set -euo pipefail

INSTALL_TYPE="$1"
VERSION="$2"
INSTALL_PATH="$3"

if [ "$(uname -s)" != "Darwin" ]; then
  echo "Error: This plugin only supports macOS." >&2
  exit 1
fi

# Detect architecture
ARCH="$(uname -m)"
case "$ARCH" in
  arm64|aarch64)
    ARCH_PATTERN="arm64"
    ;;
  x86_64)
    ARCH_PATTERN="x86_64"
    ;;
  *)
    echo "Error: Unsupported architecture: $ARCH" >&2
    exit 1
    ;;
esac

echo "Fetching latest release information from GitHub..."
REPO="eko5624/mpv-mac"
RELEASE_JSON=$(curl -sSL "https://api.github.com/repos/${REPO}/releases/latest")

# Extract download URLs for ffmpeg and mpv matching the system architecture
FFMPEG_URL=$(echo "$RELEASE_JSON" | grep -o 'https://[^"]*' | grep "ffmpeg-${ARCH_PATTERN}" | grep '\.zip$' | head -n 1 || true)
MPV_URL=$(echo "$RELEASE_JSON" | grep -o 'https://[^"]*' | grep "mpv-${ARCH_PATTERN}" | grep '\.zip$' | head -n 1 || true)

if [ -z "$FFMPEG_URL" ] || [ -z "$MPV_URL" ]; then
  echo "Error: Could not find binaries matching architecture '${ARCH_PATTERN}' in latest release." >&2
  exit 1
fi

# Prepare temporary working directories
TMP_DIR=$(mktemp -d)
trap 'rm -rf "$TMP_DIR"' EXIT

echo "Downloading packages..."
curl -sSL "$FFMPEG_URL" -o "$TMP_DIR/ffmpeg.zip"
curl -sSL "$MPV_URL" -o "$TMP_DIR/mpv.zip"

echo "Extracting packages..."
EXTRACT_DIR="$TMP_DIR/extracted"
mkdir -p "$EXTRACT_DIR"
unzip -q "$TMP_DIR/ffmpeg.zip" -d "$EXTRACT_DIR"
unzip -q "$TMP_DIR/mpv.zip" -d "$EXTRACT_DIR"

# Target installation directory
TARGET_BIN_DIR="${INSTALL_PATH}/bin"
mkdir -p "$TARGET_BIN_DIR"

echo "Locating and installing binaries..."
BINARIES=("ffmpeg" "ffplay" "ffprobe" "mpv")

for bin in "${BINARIES[@]}"; do
  FOUND_PATH=$(find "$EXTRACT_DIR" -type f -name "$bin" -print -quit)
  if [ -n "$FOUND_PATH" ]; then
    cp "$FOUND_PATH" "$TARGET_BIN_DIR/$bin"
    chmod +x "$TARGET_BIN_DIR/$bin"
    echo "  Installed $bin -> $TARGET_BIN_DIR/$bin"
  else
    echo "Warning: Binary '$bin' not found in downloaded archives." >&2
  fi
done

echo "Installation complete!"
