#!/usr/bin/env bash

set -euo pipefail

# 1. 架构与系统检查
OS="$(uname -s)"
if [ "$OS" != "Darwin" ]; then
  echo "Error: This plugin only supports macOS." >&2
  exit 1
fi

ARCH="$(uname -m)"
case "$ARCH" in
  arm64|aarch64)
    ARCH_KEY="arm64"
    ;;
  x86_64)
    ARCH_KEY="x86_64"
    ;;
  *)
    echo "Error: Unsupported architecture $ARCH" >&2
    exit 1
    ;;
esac

# 2. 获取 asdf 传入的参数
INSTALL_TYPE="$1"
VERSION="$2"
INSTALL_PATH="$3"

BIN_DIR="${INSTALL_PATH}/bin"
LIB_DIR="${INSTALL_PATH}/lib"

mkdir -p "${BIN_DIR}" "${LIB_DIR}"

# 3. 创建临时工作目录
TMP_DIR="$(mktemp -d)"
trap 'rm -rf "${TMP_DIR}"' EXIT

echo "Fetching latest release information from GitHub..."

# 4. 请求 API 获取最新 Release 的所有下载地址
RELEASE_JSON="$(curl -sSL "https://api.github.com/repos/eko5624/mpv-mac/releases/latest")"

# 解析符合当前架构的所有 zip 链接
DOWNLOAD_URLS=$(echo "$RELEASE_JSON" | grep -oE "https://[^\"]+\\.zip" | grep "${ARCH_KEY}" || true)

if [ -z "$DOWNLOAD_URLS" ]; then
  echo "Error: Could not find zip packages for architecture '${ARCH_KEY}' in the latest release." >&2
  exit 1
fi

# 5. 下载并解压对应的 zip 包
cd "${TMP_DIR}"
for url in $DOWNLOAD_URLS; do
  echo "Downloading: ${url}"
  filename=$(basename "$url")
  curl -sSL -o "$filename" "$url"
  
  echo "Unpacking: ${filename}"
  unzip -q -o "$filename" -d "extracted_${filename}"
done

# 6. 查找指定的目标二进制文件并移动到 bin/
echo "Installing binaries to ${BIN_DIR}..."
TARGET_BINS=("ffmpeg" "ffplay" "ffprobe" "mpv")

for bin_name in "${TARGET_BINS[@]}"; do
  found_file=$(find . -type f -name "$bin_name" | head -n 1)
  if [ -n "$found_file" ]; then
    echo "  -> Found ${bin_name}"
    cp -p "$found_file" "${BIN_DIR}/${bin_name}"
    chmod +x "${BIN_DIR}/${bin_name}"
  else
    echo "  -> Warning: ${bin_name} not found in release packages." >&2
  fi
done

# 7. 查找所有 *.dylib 库文件并移动到 lib/
echo "Installing dylibs to ${LIB_DIR}..."
find . -type f -name "*.dylib" -exec cp -p {} "${LIB_DIR}/" \;

echo "Successfully installed ffmpeg & mpv binaries to ${INSTALL_PATH}"
